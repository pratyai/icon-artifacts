# Python envs
.venv/
.python-version

# SQLite dev dbs. The exceptions back the paper's tables and are small enough
# to travel with the source: snr_bf16.db holds the integration SNR
# comparisons, perf_integration.db the per-call VT wrapper timings.
*.db
!snr_bf16.db
!perf_integration.db
*.db-shm
*.db-wal

# Profiling outputs (compressed .ncu-rep.zst snapshots stay tracked)
*.ncu-rep

# Arbitrary log outputs at any level
*.log

# Loose .ptx dumps only at velocity/ root (ptx_out/**/*.ptx stays tracked)
/*.ptx

# NetCDF grid caches (kept on daint / as local backup)
*.nc

# PDFs (docs/papers live elsewhere)
*.pdf

# LaTeX fragments (paper repo, not here)
performance_*.tex

# Local backups
*.bak
*.bk
*_backup
*_backup/
