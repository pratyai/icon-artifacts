--- source/cloudsc-dwarf/src/cloudsc_gpu/dwarf_cloudsc_gpu_multistep.F90.bak	2026-07-13 02:12:26.000000000 +0200
+++ source/cloudsc-dwarf/src/cloudsc_gpu/dwarf_cloudsc_gpu_multistep.F90	2026-07-13 02:12:26.000000000 +0200
@@ -49,6 +49,14 @@
 ! NaN diagnostics
 INTEGER(KIND=JPIM) :: NNAN_T, NNAN_Q, NNAN_A, NNAN_CLD
 
+! Output subsampling: env CLOUDSC_OUT_STEPS = comma-separated outer steps to dump.
+! Empty/unset = dump every step (default AD behavior).
+INTEGER(KIND=JPIM) :: NOUTSTEPS = 0
+INTEGER(KIND=JPIM) :: IOUTSTEPS(1024)
+INTEGER(KIND=JPIM) :: KOUT, IERR_OUT
+LOGICAL :: LDO_WRITE
+CHARACTER(LEN=8192) :: COUT_STEPS
+
 TYPE(CLOUDSC_GLOBAL_STATE) :: GLOBAL_STATE
 
 #include "abor1.intfb.h"
@@ -262,6 +270,23 @@
 GLOBAL_STATE%B_LOC(:,:,:,:) = 0.0_JPRB
 !$acc update device(GLOBAL_STATE%B_LOC)
 
+! Parse CLOUDSC_OUT_STEPS (comma list of outer steps to dump; empty = all)
+COUT_STEPS = ""
+CALL GET_ENVIRONMENT_VARIABLE("CLOUDSC_OUT_STEPS", COUT_STEPS)
+NOUTSTEPS = 0
+IF (LEN_TRIM(COUT_STEPS) > 0) THEN
+  DO KOUT = 1, LEN_TRIM(COUT_STEPS)
+    IF (COUT_STEPS(KOUT:KOUT) == ",") COUT_STEPS(KOUT:KOUT) = " "
+  END DO
+  DO
+    READ(COUT_STEPS, *, IOSTAT=IERR_OUT) (IOUTSTEPS(KOUT), KOUT=1, NOUTSTEPS+1)
+    IF (IERR_OUT /= 0) EXIT
+    NOUTSTEPS = NOUTSTEPS + 1
+    IF (NOUTSTEPS >= 1024) EXIT
+  END DO
+  IF (IRANK == 0) WRITE(0,'(1X,A,I0,A)') "Output subsampling: ", NOUTSTEPS, " steps"
+END IF
+
 DO JSTEP = 1, NSTEPS
 
   IF (IRANK == 0) THEN
@@ -391,9 +416,20 @@
       & ',', ZTIME_UPDATE*1000.0_JPRD, &
       & ',', ZTIME_D2H*1000.0_JPRD
 
-    CALL CLOUDSC_OUTPUT_WRITE_STEP(JSTEP, NPROMA, GLOBAL_STATE%KLEV, NCLV, &
-      & GLOBAL_STATE%NBLOCKS, GLOBAL_STATE%PT, GLOBAL_STATE%PQ, &
-      & GLOBAL_STATE%PA, GLOBAL_STATE%PCLV)
+    LDO_WRITE = (NOUTSTEPS == 0)
+    IF (.NOT. LDO_WRITE) THEN
+      DO KOUT = 1, NOUTSTEPS
+        IF (IOUTSTEPS(KOUT) == JSTEP) THEN
+          LDO_WRITE = .TRUE.
+          EXIT
+        END IF
+      END DO
+    END IF
+    IF (LDO_WRITE) THEN
+      CALL CLOUDSC_OUTPUT_WRITE_STEP(JSTEP, NPROMA, GLOBAL_STATE%KLEV, NCLV, &
+        & GLOBAL_STATE%NBLOCKS, GLOBAL_STATE%PT, GLOBAL_STATE%PQ, &
+        & GLOBAL_STATE%PA, GLOBAL_STATE%PCLV)
+    END IF
   END IF
 
 END DO
